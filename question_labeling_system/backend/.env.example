# development 会启用本地 SQLite 自动建表；production 强制 MySQL、JWT、模型工件、Hybrid RAG 和 LLM。
APP_ENV=development
# 本地留空时使用 question_labeling_system/data/question_labeling.db；生产示例见 README。
DATABASE_URL=
# 仅 development/test 可以设为 true；生产启动会拒绝该配置。
AUTH_DISABLED=true
# 生产使用 RS256 公钥 PEM 文本或容器挂载文件路径。
JWT_PUBLIC_KEY=
# JWT 标准 issuer 约束。
JWT_ISSUER=question-labeling
# JWT 标准 audience 约束。
JWT_AUDIENCE=question-labeling-api
# 只允许受信任前端来源，多个地址用逗号分隔。
CORS_ORIGINS=http://localhost:5173
# 本地 bootstrap 使用可解释规则；生产必须使用 artifact。
HISTORICAL_MODEL_MODE=bootstrap
# 生产模型工件路径，必须由训练与发布流水线挂载。
HISTORICAL_MODEL_PATH=../artifacts/label_model.joblib
# 本地 memory 使用原创小样本；生产必须使用 hybrid。
RAG_MODE=memory
# 本地可关闭 LLM；生产必须使用 openai 兼容模式。
LLM_MODE=disabled
# OpenAI、模型网关或 Ollama 的 API 密钥；不要提交真实值。
OPENAI_API_KEY=
# OpenAI 兼容 API 地址。
OPENAI_BASE_URL=http://127.0.0.1:11434/v1
# 在线结构化标签推理模型。
OPENAI_MODEL=qwen2.5:3b
# Dense RAG 使用的 Embedding 模型。
OPENAI_EMBEDDING_MODEL=nomic-embed-text
# Qdrant 服务地址。
QDRANT_URL=http://127.0.0.1:6333
# 托管 Qdrant 的可选 API 密钥；不要提交真实值。
QDRANT_API_KEY=
# 使用版本化集合名便于蓝绿切换。
QDRANT_COLLECTION=labeled_questions_v1
# 融合分数达到该阈值时前端默认勾选。
SELECTION_THRESHOLD=0.58
# 单次在线推理最多展示的 RAG 证据数。
RAG_LIMIT=6
# 人工领取任务的租约秒数。
CLAIM_LEASE_SECONDS=900
