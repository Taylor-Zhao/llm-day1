# 本地 SQLite 数据库由种子脚本和开发 API 创建。
data/*.db
# SQLite 写前日志和共享内存文件不应提交。
data/*.db-wal
data/*.db-shm
# 训练模型、评测报告和临时发布文件由流水线生成。
artifacts/*
# 保留空模型目录说明文件。
!artifacts/.gitkeep
# Python 字节码和测试缓存不应提交。
**/__pycache__/
**/*.pyc
# 本地环境变量可能包含密钥。
**/.env
# 生产 Secret 内容只允许由部署平台挂载。
secrets/*
# 保留 Secret 使用说明。
!secrets/README.md
# 前端依赖和生产构建由 npm 恢复生成。
frontend/node_modules/
frontend/dist/
# React 前端依赖和生产构建同样由 npm 恢复生成。
frontend-react/node_modules/
frontend-react/dist/
# React Playwright 临时结果不提交，仅保留 docs/screenshots 中审阅后的截图。
frontend-react/test-results/
frontend-react/playwright-report/
# 编辑器和操作系统临时文件不应提交。
.DS_Store
