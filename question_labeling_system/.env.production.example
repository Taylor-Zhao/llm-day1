# 生产环境名称会启用严格启动门禁。
APP_ENV=production
# 使用 URL 编码后的密码，避免特殊字符破坏连接串。
DATABASE_URL=mysql+pymysql://labeling:CHANGE_ME@mysql:3306/question_labeling?charset=utf8mb4
# 生产环境禁止关闭认证。
AUTH_DISABLED=false
# JWT 公钥通过只读 Secret 文件挂载。
JWT_PUBLIC_KEY=/run/secrets/jwt_public.pem
# 与企业身份提供方配置一致。
JWT_ISSUER=question-labeling
# 与 API Resource Server audience 一致。
JWT_AUDIENCE=question-labeling-api
# 替换为实际 HTTPS 前端域名。
CORS_ORIGINS=https://labeling.example.com
# 生产必须加载训练和评测通过的工件。
HISTORICAL_MODEL_MODE=artifact
# Docker 容器内只读模型路径。
HISTORICAL_MODEL_PATH=/app/artifacts/label_model.joblib
# 生产必须启用 Dense + Sparse 混合 RAG。
RAG_MODE=hybrid
# 生产必须启用 LangChain 结构化 LLM。
LLM_MODE=openai
# 通过 Secret Manager 注入真实密钥，示例文件不得填写。
OPENAI_API_KEY=CHANGE_ME
# 替换为企业模型网关或合规模型服务。
OPENAI_BASE_URL=https://model-gateway.example.com/v1
# 固定通过回归评测的模型版本或别名。
OPENAI_MODEL=label-reasoner-production
# 固定构建 Qdrant 索引时使用的 Embedding 模型。
OPENAI_EMBEDDING_MODEL=embedding-production-v1
# Compose 内部 Qdrant 地址。
QDRANT_URL=http://qdrant:6333
# 自建内部 Qdrant 可由网络策略保护；托管服务应注入密钥。
QDRANT_API_KEY=
# 使用版本化集合名支持蓝绿索引切换。
QDRANT_COLLECTION=labeled_questions_v1
# 默认标签阈值应由离线评测确定。
SELECTION_THRESHOLD=0.58
# 限制在线上下文和 Token 成本。
RAG_LIMIT=6
# 人工任务十五分钟后可被重新领取。
CLAIM_LEASE_SECONDS=900
# Compose 初始化数据库名。
MYSQL_DATABASE=question_labeling
# Compose 最小权限应用用户。
MYSQL_USER=labeling
# 通过 Secret Manager 注入，示例值必须替换。
MYSQL_PASSWORD=CHANGE_ME
# 通过 Secret Manager 注入，示例值必须替换。
MYSQL_ROOT_PASSWORD=CHANGE_ME_TOO