OPENAI_API_KEY=your_api_key_here
# Optional: OpenAI-compatible endpoint, e.g. https://api.openai.com/v1
OPENAI_BASE_URL=
# Optional: HTTP proxy for SDK, e.g. http://127.0.0.1:7890
OPENAI_HTTP_PROXY=
# Optional default model
OPENAI_MODEL=gpt-4.1-mini

