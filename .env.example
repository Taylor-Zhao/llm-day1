OPENAI_API_KEY=your_api_key_here
# Optional: OpenAI-compatible endpoint, e.g. https://api.openai.com/v1
OPENAI_BASE_URL=
# Optional: HTTP proxy for SDK, e.g. http://127.0.0.1:7890
OPENAI_HTTP_PROXY=
# Optional default model
OPENAI_MODEL=gpt-4.1-mini

# Free local model preset (Ollama, OpenAI-compatible)
# OPENAI_API_KEY=ollama
# OPENAI_BASE_URL=http://127.0.0.1:11434/v1
# OPENAI_MODEL=qwen2.5:3b
# OPENAI_HTTP_PROXY=

# Day36-Day38 unified FastAPI service
DAY36_API_KEYS=dev-api-key
DAY36_BASE_MODEL_ID=HuggingFaceTB/SmolLM2-135M-Instruct
DAY36_ADAPTER_DIR=outputs/day31_sft_lora/adapter
DAY36_INFERENCE_MODE=fp32
DAY36_HOST=0.0.0.0
DAY36_PORT=8070
DAY36_LOG_LEVEL=INFO

# Day37 rate limit + retry
DAY37_RATE_LIMIT_REQUESTS=30
DAY37_RATE_LIMIT_WINDOW_SEC=60
DAY37_RETRY_ATTEMPTS=3
DAY37_RETRY_BACKOFF_MS=200
